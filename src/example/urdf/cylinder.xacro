<?xml version="1.0"?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <model name="cylinder" canonical_link="link">

    <xacro:property name="radius"   value="0.3" />
    <xacro:property name="length"   value="1.0" />
    <xacro:property name="mass"     value="1.0" />

    <link name="link">
      <inertial>
        <mass>${mass}</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>${radius}</radius>
            <length>${length}</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>${radius}</radius>
            <length>${length}</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.2 0.2 1</ambient>
          <diffuse>1.0 0.2 0.2 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <static>true</static>
  </model>
</sdf>