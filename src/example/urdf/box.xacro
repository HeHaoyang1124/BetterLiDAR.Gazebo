<?xml version="1.0"?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <model name="box" canonical_link="link">

    <xacro:property name="size_x"   value="1.0" />
    <xacro:property name="size_y"   value="1.0" />
    <xacro:property name="size_z"   value="1.5" />
    <xacro:property name="mass"     value="1.0" />

    <link name="link">
      <inertial>
        <mass>${mass}</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>${size_x} ${size_y} ${size_z}</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>${size_x} ${size_y} ${size_z}</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 1.0 0.2 1</ambient>
          <diffuse>0.2 1.0 0.2 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <static>true</static>
  </model>
</sdf>
